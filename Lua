local function ApplyESP(character)
    if not character:FindFirstChild("ChamsHighlight") then
        local hl = Instance.new("Highlight")
        hl.Name = "ChamsHighlight"
        hl.FillColor = Color3.fromRGB(255, 0, 50) 
        hl.OutlineColor = Color3.fromRGB(255, 255, 255) 
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        hl.Adornee = character
        hl.Parent = character
    end
end

local function RemoveESP(character)
    local hl = character:FindFirstChild("ChamsHighlight")
    if hl then hl:Destroy() end
end

local function UpdateAllESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if ESPEnabled then
                ApplyESP(player.Character)
            else
                RemoveESP(player.Character)
            end
        end
    end
end

ToggleESP.MouseButton1Click:Connect(function()
    ESPEnabled = not ESPEnabled
    ToggleESP.Text = ESPEnabled and "Chams ESP: ON" or "Chams ESP: OFF"
    ToggleESP.TextColor3 = ESPEnabled and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 255, 255)
    UpdateAllESP()
end)

